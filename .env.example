# Copy to .env for local development. Never commit real secrets.
# Separate LINE channel tokens per env (local / SIT / STG / PROD).

# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000

# LINE Messaging API (placeholders — use a dedicated channel per env)
LINE_CHANNEL_SECRET=replace_me_local_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_me_local_channel_access_token

# Local webhook test: point LINE Developers Console webhook URL at
# a public HTTPS tunnel (e.g. ngrok http 3000 → https://xxxx.ngrok.io/webhook).

# Postgres (required for Phase 3+ persist). Local Docker example:
#   docker run --name line-bot-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=line_messaging_bot -p 5432:5432 -d postgres:16
# Then: npm run migrate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_messaging_bot

# --- Env stubs (document only; use separate secret stores per deploy) ---
