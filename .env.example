# Copy to .env for local development. Never commit real secrets.
# Separate LINE channel tokens per env (local / SIT / STG / PROD).

# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000

# LINE Messaging API (placeholders — use a dedicated channel per env)
LINE_CHANNEL_SECRET=replace_me_local_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_me_local_channel_access_token

# Local webhook test (Phase 2): point LINE Developers Console webhook URL at
# a public HTTPS tunnel (e.g. ngrok http 3000 → https://xxxx.ngrok.io/webhook).
# Signature verify + text echo work without a tunnel for unit/e2e tests.
# ngrok is not required for this PR's automated checks.

# --- Persist/DB is Phase 3+ (optional placeholder only; not wired yet) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_messaging_bot?schema=public

